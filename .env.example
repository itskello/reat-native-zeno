# ─── Client (safe to ship in the app bundle) ────────────────────────────────
# Anything prefixed EXPO_PUBLIC_ is embedded in the APK in cleartext.
# Only publishable / non-secret values belong here.

# Clerk publishable key. Never commit the Clerk secret key value or prefix it
# with EXPO_PUBLIC_ — it must only exist in local/server environment variables.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Where the app reaches ZENO's own API routes.
# Leave blank in production (same origin). In development, point it at the dev
# host the device can reach, e.g. http://192.168.1.20:8081
EXPO_PUBLIC_API_URL=

# Stream Chat key is public by design. The API secret below is server-only.
EXPO_PUBLIC_STREAM_API_KEY=

# ─── Server only (NEVER prefixed EXPO_PUBLIC_, never sent to the device) ─────
# These stay behind the /api routes. A secret shipped to the client can be
# extracted from the APK and used to send SMS — or forge OTPs — on ZENO's account.

# Required by authenticated Clerk user-directory search.
CLERK_SECRET_KEY=

# Stream Chat API secret. Never prefix this with EXPO_PUBLIC_.
STREAM_API_SECRET=

# Gemini assistant (server-only). Create a key at https://aistudio.google.com/app/apikey.
# The free tier is for development with synthetic support conversations only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_TIER=free

# Secret used to sign phone OTP tokens. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SIGNING_SECRET=

# Which SMS transport to use: "console" (dev, logs to server) or "africas-talking".
SMS_PROVIDER=console

# Africa's Talking credentials (used when SMS_PROVIDER=africas-talking).
# Use username "sandbox" with a sandbox API key for testing.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Registered sender ID. Leave blank until approved by ARCEP Bénin / ARTCI /
# ARCEP Togo — messages then go out on a shared shortcode.
AFRICASTALKING_SENDER_ID=

# ─── Tooling only (never read by the app) ───────────────────────────────────

# Figma personal access token, used by scripts/figma-motion.mjs to read the
# prototype's animation timings. Free on the Starter plan:
#   Figma → Settings → Security → Personal access tokens → "file content: read"
# This token grants read access to ALL your Figma files — keep it out of Git.
FIGMA_TOKEN=
